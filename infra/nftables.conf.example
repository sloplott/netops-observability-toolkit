#!/usr/sbin/nft -f
#
# Host firewall for a flow collector.
#
# WARNING: this table only protects traffic reaching the HOST (input chain).
# A port published by a Docker container does NOT pass through here — it is
# DNAT'd in PREROUTING and traverses FORWARD. Filter those in DOCKER-USER
# (see docker-user.rules.example).
#
# Replace <MGMT-RANGE>, <MGMT-HOST> and <SSH-PORT>.

table inet flow_fw {}
delete table inet flow_fw

table inet flow_fw {
  set mgmt_v4 {
    type ipv4_addr
    flags interval
    elements = { <MGMT-RANGE>, <MGMT-HOST> }
  }
  set mgmt_v6 {
    type ipv6_addr
    flags interval
    elements = { <MGMT-RANGE-V6> }
  }

  chain input {
    type filter hook input priority 0; policy drop;

    ct state established,related accept
    ct state invalid drop
    iif lo accept

    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit,
                  nd-router-advert, packet-too-big, destination-unreachable,
                  time-exceeded, parameter-problem } accept
    icmp   type { destination-unreachable, time-exceeded, parameter-problem } accept
    icmp   type echo-request limit rate 10/second accept
    icmpv6 type echo-request limit rate 10/second accept

    # SSH from management ranges only, rate limited
    tcp dport <SSH-PORT> ip  saddr @mgmt_v4 ct state new limit rate 10/minute burst 5 packets accept
    tcp dport <SSH-PORT> ip6 saddr @mgmt_v6 ct state new limit rate 10/minute burst 5 packets accept

    limit rate 5/minute log prefix "nft-drop: " level info
  }
}

# NOTE ON CONTAINERS: inside an LXC container this log line goes to the
# *host* kernel ring buffer, not the container's. rsyslog's imklog fails with
# "cannot open kernel log (/proc/kmsg): Permission denied" and firewall drops
# never reach a container-side syslog. Collect them from the hypervisor.
