    {
      "type": "timeseries",
      "id": 309,
      "title": "TOP $topn ALVOS POR PPS",
      "description": "Alvo que descola do resto em PPS e o candidato. Confira o tamanho do pacote dele na tabela ao lado.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#4FA3FF",
            "mode": "fixed"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.6,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
