      "transparent": true
    },
    {
      "type": "stat",
      "id": 302,
      "title": "PACOTES POR SEGUNDO",
      "description": "PPS agregado. Em flood de pacote e este que sobe primeiro, antes da banda.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#4FA3FF",
            "mode": "fixed"
          },
