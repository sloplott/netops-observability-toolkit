      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(TimeReceived) AS time,\n  sum(Packets * SamplingRate) / $__interval_s AS \"PPS\"\nFROM default.flows\nWHERE $__timeFilter(TimeReceived)\n  AND ExporterName IN ($host)\n  AND EType IN ($inet)\n  AND ('$alvo' = '' OR replaceRegexpOne(IPv6NumToString(DstAddr), '^::ffff:', '') = '$alvo')\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
