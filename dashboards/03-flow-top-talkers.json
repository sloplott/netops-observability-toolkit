        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "table",
          "rawSql": "WITH b AS (\n  SELECT\n    toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS t,\n    concat(\n      replaceRegexpOne(IPv6NumToString(SrcAddr), '^::ffff:', ''), ':', toString(SrcPort),\n      '  -->  ',\n      replaceRegexpOne(IPv6NumToString(DstAddr), '^::ffff:', ''), ':', toString(DstPort)\n    ) AS conversa,\n    sum(Bytes * SamplingRate) * 8 / $bucket AS bps,\n    sum(Packets * SamplingRate) / $bucket AS pps\n  FROM default.flows\n  WHERE $__timeFilter(TimeReceived)\n    AND ExporterName IN ($host)\n    AND EType IN ($inet)\n    AND ('$ip' = '' OR position(IPv6NumToString(SrcAddr), '$ip') > 0 OR position(IPv6NumToString(DstAddr), '$ip') > 0)\n    AND ('$porta' = '' OR toString(SrcPort) = '$porta' OR toString(DstPort) = '$porta')\n  GROUP BY t, conversa\n)\nSELECT\n  conversa,\n  max(bps)       AS maximo,\n  avg(bps)       AS media,\n  argMax(bps, t) AS atual,\n  max(pps)       AS pps_max\nFROM b\nGROUP BY conversa\nORDER BY maximo DESC\nLIMIT $topn"
        }
      ]
