          "editorType": "sql",
          "format": 2,
          "queryType": "table",
          "rawSql": "WITH b AS (\n  SELECT\n    toStartOfInterval(TimeReceived, INTERVAL $bucket second) AS t,\n    replaceRegexpOne(IPv6NumToString(SrcAddr), '^::ffff:', '') AS origem,\n    sum(Bytes * SamplingRate) * 8 / $bucket AS bps,\n    uniqExact(DstAddr) AS d\n  FROM default.flows\n  WHERE $__timeFilter(TimeReceived)\n    AND ExporterName IN ($host)\n    AND EType IN ($inet)\n    AND ('$ip' = '' OR position(IPv6NumToString(SrcAddr), '$ip') > 0 OR position(IPv6NumToString(DstAddr), '$ip') > 0)\n    AND ('$porta' = '' OR toString(SrcPort) = '$porta' OR toString(DstPort) = '$porta')\n  GROUP BY t, origem\n)\nSELECT\n  origem,\n  max(bps)       AS maximo,\n  avg(bps)       AS media,\n  argMax(bps, t) AS atual,\n  max(d)         AS destinos\nFROM b\nGROUP BY origem\nORDER BY maximo DESC\nLIMIT $topn"
