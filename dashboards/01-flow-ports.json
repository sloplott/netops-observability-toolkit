      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "table",
          "rawSql": "WITH top AS (\n  SELECT SrcAddr, SrcPort, DstAddr, DstPort\n  FROM default.flows\n  WHERE $__timeFilter(TimeReceived)\n    AND ExporterName IN ($host)\n    AND EType IN ($inet)\n    AND toString(DstPort) IN ($proto)\n  GROUP BY SrcAddr, SrcPort, DstAddr, DstPort\n  ORDER BY sum(Bytes * SamplingRate) DESC\n  LIMIT $topn\n)\nSELECT\n  $__timeInterval(f.TimeReceived) AS time,\n  concat(\n    replaceRegexpOne(IPv6NumToString(f.SrcAddr), '^::ffff:', ''), ':', toString(f.SrcPort),\n    '  -->  ',\n    replaceRegexpOne(IPv6NumToString(f.DstAddr), '^::ffff:', ''), ':', toString(f.DstPort)\n  ) AS metric,\n  sum(f.Bytes * f.SamplingRate) * 8 / $__interval_s AS bps\nFROM default.flows AS f\nINNER JOIN top USING (SrcAddr, SrcPort, DstAddr, DstPort)\nWHERE $__timeFilter(f.TimeReceived)\n  AND f.ExporterName IN ($host)\n  AND f.EType IN ($inet)\nGROUP BY time, metric\nORDER BY time",
          "refId": "A"
        }
      ],
      "pluginVersion": "12.2.1",
