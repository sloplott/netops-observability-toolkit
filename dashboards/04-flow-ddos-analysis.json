          "rawSql": "SELECT\n  replaceRegexpOne(IPv6NumToString(DstAddr), '^::ffff:', '') AS alvo,\n  sum(Packets * SamplingRate) / $__interval_s AS pps,\n  sum(Bytes * SamplingRate) * 8 / $__interval_s AS bps,\n  sum(Bytes) / nullIf(sum(Packets), 0) AS tam_pacote,\n  uniqExact(SrcAddr) AS origens,\n  uniqExact(SrcPort) AS portas_origem\nFROM default.flows\nWHERE $__timeFilter(TimeReceived)\n  AND ExporterName IN ($host)\n  AND EType IN ($inet)\nGROUP BY alvo\nORDER BY pps DESC\nLIMIT $topn",
          "refId": "A"
        }
