  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-clickhouse-datasource",
        "current": {
          "text": "${DS}",
          "value": "P1809F7CD0C75ACF3"
        },
        "hide": 0
      },
      {
        "name": "exporter",
        "label": "Exportador",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${ds}"
        },
        "query": "SELECT DISTINCT ExporterName FROM default.flows_1m0s WHERE ExporterName != '' ORDER BY ExporterName",
        "refresh": 2,
        "includeAll": true,
        "allValue": "",
        "multi": true,
        "current": {
          "text": [],
          "value": []
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "inet",
        "label": "INET",
        "type": "custom",
        "query": "Todos : 2048\\,34525, IPv4 : 2048, IPv6 : 34525",
        "current": {
          "text": "Todos",
          "value": "2048,34525"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "topn",
        "label": "Top N",
        "type": "custom",
        "query": "5,10,15,20",
        "current": {
          "text": "10",
          "value": "10"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0
