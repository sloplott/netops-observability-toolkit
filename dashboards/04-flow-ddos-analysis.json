      "options": {
        "legend": {
          "calcs": [
            "min",
            "max",
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "table",
          "rawSql": "WITH top AS (\n  SELECT DstAddr\n  FROM default.flows\n  WHERE $__timeFilter(TimeReceived)\n  AND ExporterName IN ($host)\n  AND EType IN ($inet)\n  GROUP BY DstAddr\n  ORDER BY sum(Packets * SamplingRate) DESC\n  LIMIT $topn\n)\nSELECT\n  $__timeInterval(f.TimeReceived) AS time,\n  replaceRegexpOne(IPv6NumToString(f.DstAddr), '^::ffff:', '') AS metric,\n  sum(f.Packets * f.SamplingRate) / $__interval_s AS pps\nFROM default.flows AS f\nINNER JOIN top USING (DstAddr)\nWHERE $__timeFilter(f.TimeReceived)\n  AND f.ExporterName IN ($host)\n  AND f.EType IN ($inet)\nGROUP BY time, metric\nORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": true
    },
