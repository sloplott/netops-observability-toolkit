          "editorType": "sql",
          "format": 1,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  $__timeInterval(TimeReceived) AS time,\n  sum(Bytes * SamplingRate) * 8 / $__interval_s AS \"BPS\"\nFROM default.flows\nWHERE $__timeFilter(TimeReceived)\n  AND ExporterName IN ($host)\n  AND EType IN ($inet)\n  AND ('$alvo' = '' OR replaceRegexpOne(IPv6NumToString(DstAddr), '^::ffff:', '') = '$alvo')\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "transparent": true
    },
    {
